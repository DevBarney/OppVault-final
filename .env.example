# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# ---- Public settings -------------------------------------------------------------------
# Supabase (Project Settings > API). Both are safe to expose: the anon key can only read
# rows marked published = true (row level security, see supabase/schema.sql).
# Leave them out to see sample listings while you develop.
NEXT_PUBLIC_SUPABASE_URL=https://fsznoimnvntxkvvfqpng.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your WhatsApp community invite link (WhatsApp > Community > Invite via link).
# Already defaults to the OppVault community; only set this to use a different link.
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/EvaSDdZLs1VEK7fSP7zzr1

# The address the site is served from (used for share previews).
NEXT_PUBLIC_SITE_URL=https://oppvault.app

# ---- Newsletter: choose ONE provider ---------------------------------------------------
# Optional. If left out, the first provider below that has its variables set is used.
# EMAIL_PROVIDER=resend         # resend | webhook | buttondown | mailchimp

# Option A (recommended): Resend
# RESEND_API_KEY=re_xxxxxxxx            # needs full access (it creates contacts)
# RESEND_SEGMENT_ID=6712e883-8bff-415f-b783-1140cb47b70d   # the "OppVault Newsletter" segment
# Optional welcome email. Only set this once your domain is verified in Resend:
# RESEND_FROM=OppVault <hello@oppvault.app>
# RESEND_REPLY_TO=hello@oppvault.app

# Option B: Webhook (Zapier, Make, n8n, a Google Apps Script, your own API...)
# Receives a JSON POST: { email, source, site, subscribedAt }
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/oppvault
# NEWSLETTER_WEBHOOK_SECRET=pick-a-long-random-string   # optional, sent as x-webhook-secret

# Option C: Buttondown
# BUTTONDOWN_API_KEY=

# Option D: Mailchimp
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxx-us21     # the part after the dash is your data centre
# MAILCHIMP_LIST_ID=                          # Audience ID

# Set to false only if you have turned confirmation emails off with your provider.
# It changes the message people see after subscribing ("check your inbox" or not).
# NEWSLETTER_DOUBLE_OPT_IN=true

# --- Admin area (/admin): CSV uploads and content management ---
# Password for /admin. At least 12 characters. Keep it private; changing it signs everyone out.
ADMIN_PASSWORD=
# Supabase secret (service role) key. SERVER ONLY. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email from the admin page (section 4) ---
# RESEND_API_KEY, RESEND_SEGMENT_ID (main subscriber list) are used as above.
# RESEND_FROM must use a domain you have verified in Resend, e.g. OppVault <hello@oppvault.app>

# Where "needs your attention" emails go (new post to review, new visitor suggestion). Use your own inbox.
# Needs RESEND_API_KEY and RESEND_FROM. If unset, hello@oppvault.app is used.
ADMIN_NOTIFY_EMAIL=

# --- Visitor accounts (sign in to save opportunities) ---
# Uses NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY (above) and, for "Delete my account",
# SUPABASE_SERVICE_ROLE_KEY. Switch the sign-in options on in Supabase: see docs/ACCOUNTS-SETUP.md.
# Which social buttons to show, comma separated. Default (unset) shows all three. Example: google
NEXT_PUBLIC_AUTH_PROVIDERS=
